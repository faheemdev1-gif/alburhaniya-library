+        for prefix in _LEXEME_PREFIXES:
+            for suffix in _LEXEME_SUFFIXES:
+                key = normalize_search_text(prefix + stem + suffix, level="broad")
+                forms.update(vocabulary.get(key, ()))
+    return sorted(forms)
